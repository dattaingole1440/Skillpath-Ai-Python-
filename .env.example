# SkillPath AI - Environment Variables Example

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Security & JWT
# You can generate a random secret key using: openssl rand -hex 32
SECRET_KEY=replace_this_with_a_secure_random_hex_string_32_bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (MySQL)
# Example: mysql+pymysql://username:password@host:port/database_name
DATABASE_URL=mysql+pymysql://root:admin123@localhost:3306/skillpath_ai

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
